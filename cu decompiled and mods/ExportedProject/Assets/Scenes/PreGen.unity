  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "With non-pixel art by WickFlix\n<size=20><color=#9999>I found out about the game right at the start of 2025 and quickly felt enraptured by the atmosphere and themes, and ended up making tons of fanart in the community as an outlet for my appreciation of the project. Somewhere along the way I offered to help with art assets, and I've been working together with Moffee since! Seeing the game take shape and being there to help it along has been lovely, and I hope to carry on doing it <3"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: ef15b4a1e8af3ae46bfcb652b838e97e, type: 2}
  m_sharedMaterial: {fileID: 2100000, guid: 94ad77c7e91a68e42ad78867ac625f95, type: 2}

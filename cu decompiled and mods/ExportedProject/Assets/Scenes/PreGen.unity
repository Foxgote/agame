  m_text: "[FAMILY] \"Canine\"\n[CALLOUT_QUOTE] \"H-huh? Me? Is it my time to go..?\"\n[SUCCESS_PREDICTION] \"0.00374%\"\n[NOTES] \"Uninteresting\"\n"

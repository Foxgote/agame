                        }
                     }
                  }
                  else
                  {
                     if(myExpLoader.data == "xL")
                     {
                        exp_alive = false;
                        return;
                     }
                     if(!(myExpLoader.data == "xR" || myExpLoader.data == "xPB" || myExpLoader.data == "xSE"))
                     {
                        if(myExpLoader.data != "xTL")
                        {
                           if(myExpLoader.data == "xDL")

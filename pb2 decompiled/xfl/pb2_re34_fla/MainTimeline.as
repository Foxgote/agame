                                    if(this.TracePointNoRagdolls(this.MP_start_x,this.MP_start_y - 50))
                                    {
                                       if(this.TracePointNoRagdolls(this.MP_start_x - 10,this.MP_start_y - 50))
                                       {
                                          if(this.TracePointNoRagdolls(this.MP_start_x + 10,this.MP_start_y - 50))
                                          {
                                             if(!this.TracePointNoRagdolls(this.MP_start_x - 10,this.MP_start_y + 50))
                                             {
                                                if(!this.TracePointNoRagdolls(this.MP_start_x + 10,this.MP_start_y + 50))

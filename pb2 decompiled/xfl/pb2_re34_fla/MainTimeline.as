                           }
                        }
                        ++this.i2;
                     }
                     if(this.ok)
                     {
                        if(!this.ainwater[this.i])
                        {
                           if(this.wa_friction[this.ainwater_shape[this.i]])
                           {
                              if(this.xx > 4)

               }
               i++;
            }
            i = 0;
            while(i < this.ef.length)
            {
               if(this.ef[i])
               {
                  if(this.ef[i].msgtext)
                  {
                     this.ef[i].scaleX = this.ef[i].scaleY = 1;
                  }
               }
               i++;
            }
            jpgEncoder = new JPGEncoder(90);
            bytes = jpgEncoder.encode(bitmapData);
            this.myRequest = new URLRequest(this.MP_screenshot_server);

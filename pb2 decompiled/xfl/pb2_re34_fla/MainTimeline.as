                           this.timeshiftch = this.s_slow_up.play(0,0,this.vol);
                           if(this.HQ && this.SCREEN_EFFECTS)
                           {
                              this.whitness.alpha += 1;
                              this.whitness.visible = true;
                           }
                        }
                        else if(this.ALLOW_TIMESHIFT)
                        {
                           if(this.energy > 10)
                           {
                              if(!this.mens[this.MP_myid].dead)
                              {
                                 this.energy -= 10;
                                 this.timeshift = 1;
                                 this.timeshiftch = this.s_slow_down.play(0,0,this.vol);
                                 if(this.HQ && this.SCREEN_EFFECTS)
                                 {
                                    this.whitness.alpha += 1;
                                    this.whitness.visible = true;
                                 }
                              }
                           }
                        }
                     }
                  }
               }
               if(event.keyCode == 34)
               {
                  if(!this.key_alt)
                  {
                     if(!this.MP_mode)
                     {
                        this.key_alt = true;
                        if(this.timeshift > 0)
                        {
                           this.timeshift = 0;
                           this.timeshiftch = this.s_slow_up.play(0,0,this.vol);
                           if(this.HQ && this.SCREEN_EFFECTS)
                           {
                              this.whitness.alpha += 1;
                              this.whitness.visible = true;
                           }
                        }
                     }
                  }
               }
               if(event.keyCode == 33)
               {
                  if(!this.key_alt)
                  {
                     if(!this.MP_mode)
                     {
                        this.key_alt = true;
                        if(this.timeshift <= 0)
                        {
                           if(this.ALLOW_TIMESHIFT)
                           {
                              if(this.energy > 10)
                              {
                                 if(!this.mens[this.MP_myid].dead)
                                 {
                                    this.energy -= 10;
                                    this.timeshift = 1;
                                    this.timeshiftch = this.s_slow_down.play(0,0,this.vol);
                                    if(this.HQ && this.SCREEN_EFFECTS)
                                    {
                                       this.whitness.alpha += 1;
                                       this.whitness.visible = true;
                                    }
                                 }
                              }
                           }
                        }
                     }
                  }
               }
               if(this.KINETIC_MODULE_ENABLED)
               {
                  if(event.keyCode == 67)
                  {
                     if(!this.key_kinetic)
                     {
                        this.key_kinetic = true;
                        this.cinetic_target = -1;
                        best_di = -1;
                        i = 0;
                        while(i < this.atotal)
                        {
                           if(this.aio[i] == true || this.aio[i] == false)
                           {
                              if(this.aof[i] >= 0 && this.aof[i] < 100 && this.mens[this.aof[i]].incar == -1 && this.aof[i] != this.MP_myid || this.aof[i] >= 100 || this.aof[i] > -200 && this.aof[i] <= -100 || this.aof[i] < 0 && this.aof[i] > -100 && !this.guns[-this.aof[i] - 1].forcars && this.guns[-this.aof[i] - 1].alpha > 0)
                              {
                                 if(this.arad[i] < 16)
                                 {
                                    if(this.arad[i] > 0)
                                    {
                                       di = this.Dist2D(this.ax[i],this.ay[i],this.mens[this.MP_myid].tarx,this.mens[this.MP_myid].tary);
                                       if(di < this.arad[i] + 40)
                                       {
                                          this.ok = true;
                                          if(this.aactive[i] != 1000)
                                          {
                                             if(this.aof[i] < 0 && this.aof[i] > -100)
                                             {
                                                if(this.guns[-this.aof[i] - 1].picken_by != -1)
                                                {
                                                   if(!this.guns[-this.aof[i] - 1].forcars)
                                                   {
                                                      if(this.guns[-this.aof[i] - 1].picken_by == this.MP_myid || this.mens[this.guns[-this.aof[i] - 1].picken_by].team != this.mens[this.MP_myid].team)
                                                      {
                                                         this.ok = false;
                                                      }
                                                   }
                                                }
                                             }
                                          }
                                          if(this.ok)
                                          {
                                             if(di < best_di || best_di == -1)
                                             {
                                                this.cinetic_target = i;
                                                best_di = di;
                                             }
                                          }
                                       }
                                    }
                                 }
                              }
                           }
                           i++;
                        }
                     }
                  }
               }
               if(this.mens[this.MP_myid].hea > 0)
               {
                  if(event.keyCode >= 48 && event.keyCode <= 57 || event.keyCode == 167 || event.keyCode == 192 || event.keyCode == 0)
                  {
                     if(event.keyCode == 48 || event.keyCode == 167 || event.keyCode == 192 || event.keyCode == 0)
                     {
                        if(this.mens[this.MP_myid].curwea != -1)
                        {
                           this.last_gun_b4_psi = this.mens[this.MP_myid].curwea;
                           this.mens[this.MP_myid].curwea = -1;
                           this.ChangedGun(this.MP_myid);
                           this.UpdateCurGun();
                        }
                     }
                     else
                     {
                        i = 0;
                        while(i < this.gunstotal)
                        {
                           if(this.guns[i].io)
                           {
                              this.mc = this.guns[i];
                              if(this.mc.picken_by == this.MP_myid && !this.mc.forcars)
                              {
                                 if(this.mc.wep == event.keyCode - 48)
                                 {
                                    if(this.mens[this.MP_myid].curwea != i)
                                    {
                                       this.last_gun_b4_psi = this.mens[this.MP_myid].curwea;
                                       this.mens[this.MP_myid].curwea = i;
                                       this.ChangedGun(this.MP_myid);
                                       this.UpdateCurGun();
                                    }
                                 }
                              }
                           }
                           i++;
                        }
                     }
                  }
               }
            }
         }
         if(currentLabel == "channel")
         {
            if(this.lobbywindow.visible && event.keyCode == Keyboard.ENTER)
            {
               this.sendLobbyMessage();
            }
         }
         this.VarChangePreventEnd();
      }
      
      public function onMouseWheelEvent(param1:Event) : void
      {
         var _loc2_:Number = NaN;
         var _loc3_:Number = NaN;
         var _loc4_:Number = NaN;
         this.VarChangePreventStart();
         if(this.MOUSE_WHEEL)
         {
            if(currentLabel == "gaming")
            {
               if(!this.MP_spectator)
               {
                  if(!this.OVERSCROLL || getTimer() > this.let_scroll_last + 150)
                  {
                     this.let_scroll_last = getTimer();
                     if(this.mens[this.MP_myid].hea > 0)
                     {
                        this.ok = true;
                        this.last_gun_b4_psi = this.mens[this.MP_myid].curwea;
                        if(this.mens[this.MP_myid].curwea == -1)
                        {
                           this.i = -1;
                        }
                        else
                        {
                           this.i = this.guns[this.mens[this.MP_myid].curwea].wep;
                        }
                        if(param1.delta > 0)
                        {
                           this.i2 = 1;
                        }
                        else
                        {
                           this.i2 = -1;
                        }
                        this.i3 = this.mens[this.MP_myid].curwea;
                        while(this.ok)
                        {
                           this.i += this.i2;
                           if(this.i > 9)
                           {
                              this.i = -1;
                           }
                           if(this.i < -1)
                           {
                              this.i = 9;
                           }
                           if(this.i == -1)
                           {
                              this.mens[this.MP_myid].curwea = -1;
                              this.ok = false;
                              this.ChangedGun(this.MP_myid);
                              this.UpdateCurGun();
                           }
                           else
                           {
                              this.i4 = 0;
                              while(this.i4 < this.gunstotal)
                              {
                                 if(this.guns[this.i4].io)
                                 {
                                    this.mc = this.guns[this.i4];
                                    if(this.mc.picken_by == this.MP_myid && !this.mc.forcars)
                                    {
                                       if(this.mc.wep == this.i)
                                       {
                                          this.mens[this.MP_myid].curwea = this.i4;
                                          this.ok = false;
                                          this.ChangedGun(this.MP_myid);
                                          this.UpdateCurGun();
                                       }
                                    }
                                 }
                                 ++this.i4;
                              }
                           }
                        }
                     }
                  }
               }
               else
               {
                  _loc2_ = 0.03;
                  _loc3_ = 1.5;
                  _loc4_ = 0;
                  if(getTimer() - _loc4_ < 200)
                  {
                     _loc2_ *= _loc3_;
                  }
                  _loc4_ = Number(getTimer());
                  if(param1.delta > 0 && this.game_scale <= 9)
                  {
                     this.game_scale = Math.min(9,this.game_scale + _loc2_);
                  }
                  else if(param1.delta < 0 && this.game_scale >= 0.05)
                  {
                     this.game_scale = Math.max(0.05,this.game_scale - _loc2_);
                  }
               }
            }
         }
         this.VarChangePreventEnd();
      }
      

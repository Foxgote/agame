<DOMTextAttrs alignment="left" rotation="true" indent="0.0" leftMargin="0.0" autoKern="false" lineSpacing="2.15" rightMargin="0.0" size="8" bitmapSize="160" face="DejaVu Sans Mono Bold"/>
</textAttrs>
</DOMTextRun>
<DOMTextRun>
<characters>- It may be more suitable for PVE multiplayer games.</characters>

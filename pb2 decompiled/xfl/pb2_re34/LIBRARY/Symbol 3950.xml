</textAttrs>
</DOMTextRun>
<DOMTextRun>
<characters>- Your bullets may have different trajectories in the enemy</characters>
<textAttrs>
<DOMTextAttrs alignment="left" rotation="true" indent="0.0" leftMargin="0.0" autoKern="true" lineSpacing="2.15" rightMargin="0.0" size="8" bitmapSize="160" face="DejaVu Sans Mono Bold" fillColor="#ffffff"/>
